# SQLite database file. Relative paths are resolved from the project root.
DATABASE_URL=sqlite:///./data/insight_engine.db

# Optional API server settings.
API_HOST=127.0.0.1
API_PORT=8000

# Required shared access key. Generate with:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
INSIGHT_API_KEY=

# Maximum accepted dataset upload size in mebibytes.
MAX_UPLOAD_SIZE_MB=25
